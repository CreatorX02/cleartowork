# Example environment variables. Copy to .env for local development.
# Never commit real secrets — .env* is gitignored; store production values in
# the Railway service variables and CI secrets.

# --- Database (Railway Postgres plugin injects this in production) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cleartowork

# --- Auth (Better Auth) ---
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Canonical public origin. Also used for Stripe redirect URLs.
BETTER_AUTH_URL=http://localhost:3000
# Optional Google sign-in; omit both to disable the provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe billing ---
# Omit STRIPE_SECRET_KEY to run without billing: the billing page renders in a
# "not configured" state and the webhook returns 501.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` locally,
# or the endpoint's signing secret in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs (price_...) — one recurring price per plan.
STRIPE_PRICE_SOLO=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_MULTI_SITE=

# --- Evidence storage (Cloudflare R2 or S3, EU region) ---
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=cleartowork-evidence
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Email (Resend) ---
# Without a key, alert emails are logged to the console instead of sent.
RESEND_API_KEY=
EMAIL_FROM=ClearToWork <alerts@example.com>

# --- Companies House onboarding autofill (optional, free API) ---
# Without a key the lookup route returns 501 and onboarding stays manual.
COMPANIES_HOUSE_API_KEY=

# --- Railway MCP tooling (see docs/MCP.md) ---
RAILWAY_TOKEN=
